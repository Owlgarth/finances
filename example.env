# Copy to .env — docker-compose.yml and ./dev.sh read every value from here.
# Change the *_PORT values if something already owns a port on your machine.
# dev.sh sources this file, so quote any value containing spaces.

# --- Dev tooling --------------------------------------------------------------
# Where ./dev.sh runs the backend/frontend commands: 'docker' needs nothing but
# Docker on your machine, 'host' uses your own uv and node (faster).
DEV_TARGET=docker

# --- Published host ports -----------------------------------------------------
DB_PORT=5432
REDIS_PORT=6379
API_PORT=8000
UI_PORT=5173
STORAGE_PORT=9000
STORAGE_CONSOLE_PORT=9001
PARSER_PORT=8100

# --- Database (host = compose service name) -----------------------------------
POSTGRES_DB=denarly_db
POSTGRES_USER=denarly_user
POSTGRES_PASSWORD=denarly_pass
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- Redis / Celery -----------------------------------------------------------
REDIS_URL=redis://redis:6379
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
# true = run tasks inline in the api process (no worker container needed)
CELERY_TASK_ALWAYS_EAGER=false

# --- Django -------------------------------------------------------------------
SECRET_KEY=change-me-to-a-random-64-char-string
JWT_SECRET_KEY=change-me-to-a-different-random-64-char-string
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
TOKEN_MAX_AGE=604800
DEBUG=true
DEMO_MODE=false
ALLOWED_HOSTS=localhost,127.0.0.1,api
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FRONTEND_URL=http://localhost:5173
EXCHANGE_SHORTCUTS_MAX_PER_WORKSPACE=5

# --- Frontend (read by the Vite dev server) -----------------------------------
VITE_API_URL=http://localhost:8000/api
VITE_DEMO_MODE=false

# --- Storage ------------------------------------------------------------------
# S3_ENDPOINT_URL: reached from inside the network. S3_EXTERNAL_URL: from the browser.
USE_S3_STORAGE=true
S3_ENDPOINT_URL=http://storage:9000
S3_EXTERNAL_URL=http://localhost:9000
S3_ACCESS_KEY=rustfsadmin
S3_SECRET_KEY=rustfsadmin
S3_BUCKET_STATIC=denarly-static
S3_BUCKET_MEDIA=denarly-media
S3_BUCKET_LOGS=denarly-logs

# --- Email (SMTP) — leave EMAIL_HOST empty to print emails to the console ------
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=noreply@denarly.com

# --- Legal documents ----------------------------------------------------------
LEGAL_OPERATOR_NAME="Your Company Name"
LEGAL_OPERATOR_TYPE=company
LEGAL_CONTACT_EMAIL=legal@example.com
LEGAL_CONTACT_ADDRESS=
LEGAL_JURISDICTION="Your Jurisdiction"

# --- Receipt parser (optional) ------------------------------------------------
# Runs under `docker compose --profile parser up`. Leave PARSER_URL empty to
# disable extraction entirely (the UI then hides every extraction affordance).
# Copy variables from ./services/receipt-parser/.enb.example to run it from this
# docker compose setup
PARSER_URL=
PARSER_API_TOKEN=local-parser-token
PARSER_MODEL_BASE_URL=http://host.docker.internal:11434/v1
PARSER_MODEL_NAME=qwen2.5-vl
PARSER_MODEL_API_KEY=not-needed
