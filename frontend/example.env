# API Configuration
# The base URL for the backend API (host dev server only: a deployed ui
# container reads API_URL at runtime instead - see prod/.env.example)
# Example: http://localhost:8000/api
VITE_API_URL=http://localhost:8000/api

# Demo Mode Configuration
# Set to "true" to hide registration link (for demo/public instances)
VITE_DEMO_MODE=false

# Dev Server Port (optional, defaults to 5173)
# VITE_PORT=5173
