POSTGRES_DB=denarly_db
POSTGRES_USER=denarly_user
POSTGRES_PASSWORD=denarly_pass
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
SECRET_KEY=change-me-to-random-64-char-string
JWT_SECRET_KEY=change-me-to-different-random-64-char-string
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DEMO_MODE=false
REDIS_URL=redis://localhost:6379

# Legal document operator settings (for privacy policy, terms of service)
# LEGAL_OPERATOR_NAME can be a company name or individual's name
# LEGAL_OPERATOR_TYPE should be 'company' or 'individual'
LEGAL_OPERATOR_NAME=Your Company Name
LEGAL_OPERATOR_TYPE=company
LEGAL_CONTACT_EMAIL=legal@example.com
LEGAL_CONTACT_ADDRESS=
LEGAL_JURISDICTION=Your Jurisdiction

# Email (SMTP)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=noreply@denarly.com

# Frontend URL (used in email links)
FRONTEND_URL=http://localhost:5173

# Token max age in seconds (default: 7 days)
TOKEN_MAX_AGE=604800

# Max exchange shortcuts per workspace (default: 5)
EXCHANGE_SHORTCUTS_MAX_PER_WORKSPACE=5

# Number of trusted reverse proxies in front of the API (default: 0).
# 0 = X-Forwarded-For is ignored and REMOTE_ADDR is used (correct when the API
# is exposed directly, e.g. uvicorn on API_PORT). Set to 1+ only when deployed
# behind exactly that many trustworthy proxies.
TRUSTED_PROXY_COUNT=0

# Rate limiting (defaults shown)
# Max login attempts per account (email) within the period window, regardless of source IP
RATE_LIMIT_LOGIN_ACCOUNT=10
# Time window (seconds) for per-account login rate limiting
RATE_LIMIT_LOGIN_ACCOUNT_PERIOD=60
# Max registration attempts per email within RATE_LIMIT_REGISTER_ACCOUNT_PERIOD
RATE_LIMIT_REGISTER_ACCOUNT=5
# Time window (seconds) for per-email registration rate limiting
RATE_LIMIT_REGISTER_ACCOUNT_PERIOD=3600
# Per-user 2FA verification lockout (default: 10 attempts per 15 minutes,
# independent of client IP; backstop against IP-rotation brute force on the 6-digit code)
RATE_LIMIT_VERIFY_2FA_USER=10
RATE_LIMIT_VERIFY_2FA_USER_PERIOD=900
