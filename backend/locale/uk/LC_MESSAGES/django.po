#: accounts/exceptions.py:9
msgid "Account not found"
msgstr "Рахунок не знайдено"

#: accounts/exceptions.py:14
msgid "Account with this name already exists"
msgstr "Рахунок з такою назвою вже існує"

#: accounts/exceptions.py:19
msgid "Account currency cannot be changed after creation"
msgstr "Валюту рахунку не можна змінити після створення"

#: accounts/exceptions.py:24
msgid "Account has records and cannot be deleted. Archive it instead."
msgstr "Рахунок містить записи і не може бути видалений. Заархівуйте його натомість."

#: accounts/schemas.py:25 accounts/schemas.py:43 budgeting/schemas.py:32
#: budgeting/schemas.py:61 budgeting/schemas.py:110 budgeting/schemas.py:131
#: categories/schemas.py:18 categories/schemas.py:31
