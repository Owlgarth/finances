msgstr "Активної згоди цього типу не знайдено"

#: users/exceptions.py:27
msgid "Two-factor authentication is not enabled for this user"
msgstr "Двофакторна автентифікація не увімкнена для цього користувача"

#: users/exceptions.py:34
#, python-format
msgid ""
"Cannot delete account. You own workspaces with other members: "
"%(workspaces)s. Transfer ownership or remove all members first."
msgstr "Не можна видалити обліковий запис. Ви володієте робочими просторами з іншими учасниками: %(workspaces)s. Спочатку передайте право власності або видаліть усіх учасників."

#: users/exceptions.py:41
msgid "Email is already verified"
msgstr "Електронну пошту вже підтверджено"

#: users/exceptions.py:46
msgid "Invalid or expired verification token"
msgstr "Недійсний або прострочений токен підтвердження"

#: users/exceptions.py:51
msgid "This email is already in use"
msgstr "Ця адреса електронної пошти вже використовується"

#: users/exceptions.py:56
msgid "Invalid or expired email change token"
msgstr "Недійсний або прострочений токен зміни електронної пошти"

#: users/exceptions.py:61
msgid "New email must be different from current email"
msgstr "Нова електронна пошта має відрізнятися від поточної"

