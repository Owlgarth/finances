#, python-format
msgid "workspace_id is required for %(model)s.for_workspace(), got %(value)r"
msgstr "Для %(model)s.for_workspace() потрібен workspace_id, отримано %(value)r"

#: common/throttle.py:55 common/throttle.py:88 common/throttle.py:127
msgid "Too many requests. Please try again later."
msgstr "Забагато запитів. Будь ласка, спробуйте пізніше."

#: common/throttle.py:149
#, python-format
msgid "File too large. Maximum %(max)sMB allowed."
msgstr "Файл завеликий. Максимально допустимо %(max)s МБ."

#: core/api.py:127
msgid "Email verified successfully"
msgstr "Електронну пошту успішно підтверджено"

#: core/api.py:140
msgid "If your email is unverified, a new verification email has been sent."
msgstr "Якщо ваша електронна пошта ще не підтверджена, надіслано новий лист для підтвердження."

#: core/api.py:151
msgid "If an account exists with this email, a reset link has been sent."
msgstr "Якщо обліковий запис із цією адресою існує, надіслано посилання для відновлення."

#: core/api.py:165
msgid "Invalid reset link"
msgstr "Недійсне посилання для відновлення"

#: core/api.py:168
msgid "Invalid or expired reset link"
msgstr "Недійсне або прострочене посилання для відновлення"

#: core/api.py:172
msgid "Password has been reset successfully"
msgstr "Пароль успішно скинуто"

#: core/api.py:180
msgid "Verification email sent to your new address"
msgstr "Лист для підтвердження надіслано на вашу нову адресу"

#: core/api.py:188
msgid "Email changed successfully"
msgstr "Електронну пошту успішно змінено"

#: core/schemas/auth.py:19
msgid "Enter a valid email address"
msgstr "Введіть дійсну адресу електронної пошти"

#: core/schemas/auth.py:68
#, python-format
msgid "Must accept current Terms of Service version (%(version)s)"
msgstr "Потрібно прийняти поточну версію Умов обслуговування (%(version)s)"

#: core/schemas/auth.py:78
#, python-format
msgid "Must accept current Privacy Policy version (%(version)s)"
msgstr "Потрібно прийняти поточну версію Політики конфіденційності (%(version)s)"

#: core/schemas/consent.py:20
#, python-format
msgid "consent_type must be one of: %(types)s"
msgstr "consent_type має бути одним із: %(types)s"

#: core/schemas/users.py:57
msgid "calendar_start_day must be between 1 and 7"
msgstr "calendar_start_day має бути в межах від 1 до 7"

#: core/schemas/users.py:66
#, python-format
msgid "font_family must be one of: %(fonts)s"
msgstr "font_family має бути одним із: %(fonts)s"

#: core/schemas/users.py:73
#, python-format
msgid "language must be one of: %(codes)s"
msgstr "language має бути одним із: %(codes)s"

#: core/schemas/users.py:80
#, python-format
msgid "number_format must be one of: %(codes)s"
msgstr "number_format має бути одним із: %(codes)s"

#: currencies/exceptions.py:12
#, python-format
msgid "Currency %(code)s not found in the catalog"
msgstr "Валюту %(code)s не знайдено в каталозі"

#: currencies/exceptions.py:19
#, python-format
msgid "Currency %(code)s is not enabled for this workspace"
msgstr "Валюту %(code)s не увімкнено для цього робочого простору"

#: currencies/exceptions.py:26
#, python-format
msgid "Currency %(code)s already exists"
msgstr "Валюта %(code)s вже існує"

#: currencies/exceptions.py:30
msgid "Cannot disable the only enabled currency of a workspace"
msgstr "Не можна вимкнути єдину увімкнену валюту робочого простору"

#: currencies/exceptions.py:36
msgid ""
"The currency order must list exactly the workspace's enabled currencies "
"(same set, no duplicates, none missing, none extra)"
msgstr "Порядок валют має точно відтворювати увімкнені валюти робочого простору (той самий набір, без дублікатів, без пропущених і зайвих)"

