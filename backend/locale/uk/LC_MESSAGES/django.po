msgstr "Валюту %(currency)s не знайдено в робочому просторі"

#: common/exceptions.py:63
msgid "Insufficient permissions"
msgstr "Недостатньо прав"

#: common/models.py:48
#, python-format
msgid "%(model)s.workspace_id must be set before save"
msgstr "%(model)s.workspace_id потрібно встановити до збереження"

#: common/models.py:55
#, python-format
msgid "%(model)s.workspace_id cannot be changed after creation"
msgstr "%(model)s.workspace_id не можна змінювати після створення"

