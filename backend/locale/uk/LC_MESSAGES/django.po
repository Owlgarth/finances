#: planned_transactions/api.py:171 transactions/api.py:175
msgid "Invalid JSON file."
msgstr "Недійсний файл JSON."

#: planned_transactions/api.py:175
msgid "No new planned transactions to import."
msgstr "Немає нових запланованих транзакцій для імпорту."

#: planned_transactions/api.py:176
#, python-format
msgid "Successfully imported %(count)s new planned transactions."
msgstr "Успішно імпортовано нові заплановані транзакції (%(count)s)."

#: planned_transactions/exceptions.py:9
msgid "Planned transaction not found"
msgstr "Заплановану транзакцію не знайдено"

#: planned_transactions/exceptions.py:14
msgid "Account is archived and cannot receive new planned transactions"
msgstr "Рахунок архівовано, він не може отримувати нові заплановані транзакції"

#: planned_transactions/exceptions.py:19
msgid "Currency does not match the account currency"
msgstr "Валюта не відповідає валюті рахунку"

#: planned_transactions/exceptions.py:24
msgid "Currency is required when no account is set"
msgstr "Валюта потрібна, коли рахунок не вказано"

#: planned_transactions/exceptions.py:29 transactions/exceptions.py:14
msgid "Category not found, archived, or not in this workspace"
msgstr "Категорію не знайдено, архівовано або її немає в цьому робочому просторі"

#: planned_transactions/exceptions.py:34
msgid "Already executed"
msgstr "Вже виконано"

#: planned_transactions/exceptions.py:39
msgid "Cannot change status of an executed planned transaction"
msgstr "Не можна змінювати статус виконаної запланованої транзакції"

#: transactions/api.py:180
msgid "No new transactions to import."
msgstr "Немає нових транзакцій для імпорту."

#: transactions/api.py:181
#, python-format
msgid "Successfully imported %(count)s new transactions."
msgstr "Успішно імпортовано нові транзакції (%(count)s)."

#: transactions/api.py:349 transactions/api.py:372
msgid "Receipt extraction is not configured."
msgstr "Розпізнавання позицій чека не налаштовано."

#: transactions/api.py:356
msgid "Receipt scanning is temporarily offline. Please try again later."
msgstr "Сканування чеків тимчасово недоступне. Будь ласка, спробуйте пізніше."

#: transactions/exceptions.py:9
msgid "Transaction not found"
msgstr "Транзакцію не знайдено"

#: transactions/exceptions.py:19
msgid "Account is archived and cannot receive new transactions"
msgstr "Рахунок архівовано, він не може отримувати нові транзакції"

#: transactions/exceptions.py:24
msgid ""
"Amount must be positive (income/expense) or a non-zero delta (adjustment)"
msgstr "Сума має бути додатною (дохід/витрата) або ненульовою дельтою (коригування)"

#: transactions/exceptions.py:29
msgid "Adjustments cannot have a category"
msgstr "Коригування не можуть мати категорію"

#: transactions/exceptions.py:34
msgid "Adjustments require an account"
msgstr "Коригування потребують рахунку"

#: transactions/exceptions.py:39
msgid "Transactions without an account require an explicit currency_code"
msgstr "Транзакції без рахунку потребують явного currency_code"

#: transactions/exceptions.py:44
msgid "currency_code does not match the account currency"
msgstr "currency_code не відповідає валюті рахунку"

#: transactions/exceptions.py:51
msgid "Original currency is unknown or equals the transaction currency"
msgstr "Початкова валюта невідома або збігається з валютою транзакції"

#: transactions/exceptions.py:56
msgid "All transactions and the target account must belong to the workspace"
msgstr "Усі транзакції та цільовий рахунок мають належати робочому простору"

#: transactions/exceptions.py:61
msgid ""
"Target account currency must match the currency of every moved transaction"
msgstr "Валюта цільового рахунку має збігатися з валютою кожної перенесеної транзакції"

#: transactions/exceptions.py:71
msgid "Attachment not found"
msgstr "Вкладення не знайдено"

#: transactions/exceptions.py:76
msgid "Unsupported file type — allowed: JPEG, PNG, HEIC, WebP, PDF"
msgstr "Непідтримуваний тип файлу — допустимо: JPEG, PNG, HEIC, WebP, PDF"

#: transactions/exceptions.py:82
msgid "File storage is not configured"
msgstr "Файлове сховище не налаштовано"

#: transactions/exceptions.py:87
msgid "The stored file is no longer available"
msgstr "Збережений файл більше недоступний"

#: transactions/schemas.py:50 transactions/schemas.py:74
msgid "Description cannot be empty"
msgstr "Опис не може бути порожнім"

#: transactions/schemas.py:56
msgid ""
"original_amount and original_currency_code must both be set or both be "
"omitted"
msgstr "original_amount і original_currency_code потрібно встановити обидва або пропустити обидва"

#: transactions/schemas.py:163
msgid "Item name cannot be empty"
msgstr "Назва позиції не може бути порожньою"

#: transactions/services.py:123
#, python-format
msgid "Original currency %(code)s not found in the catalog"
msgstr "Початкову валюту %(code)s не знайдено в каталозі"

#: transactions/services.py:126
msgid "Original currency must differ from the transaction currency"
msgstr "Початкова валюта має відрізнятися від валюти транзакції"

#: transactions/services.py:767
#, python-format
msgid "Invalid data format: %(error)s"
msgstr "Недійсний формат даних: %(error)s"

#: transfers/exceptions.py:9
msgid "Transfer not found"
msgstr "Переказ не знайдено"

#: transfers/exceptions.py:14 transfers/schemas.py:28
msgid "From and to accounts must differ"
msgstr "Рахунок-джерело і рахунок-призначення мають відрізнятися"

#: transfers/exceptions.py:19
msgid "Cannot transfer to or from an archived account"
msgstr "Не можна переказувати на архівований рахунок або з нього"

#: transfers/exceptions.py:24
msgid "Transfer amounts must be positive"
msgstr "Суми переказу мають бути додатними"

#: transfers/exceptions.py:29
msgid "Amounts must match for same-currency transfers"
msgstr "Суми мають збігатися для переказів у межах однієї валюти"

#: transfers/exceptions.py:34
msgid "to_amount is required for cross-currency transfers"
msgstr "to_amount потрібен для переказів між різними валютами"

#: users/api.py:72
msgid "Password updated successfully"
msgstr "Пароль успішно оновлено"

#: users/api.py:159
msgid "Account and all associated data deleted successfully."
msgstr "Обліковий запис і всі пов’язані дані успішно видалено."

#: users/api.py:181
msgid "Account reset. A fresh workspace is ready."
msgstr "Обліковий запис скинуто. Новий робочий простір готовий."

#: users/api.py:259
msgid "Two-factor authentication has been disabled"
msgstr "Двофакторну автентифікацію вимкнено"

#: users/exceptions.py:9
msgid "Invalid current password"
msgstr "Недійсний поточний пароль"

#: users/exceptions.py:16
#, python-format
msgid "Invalid consent type: %(consent_type)s"
msgstr "Недійсний тип згоди: %(consent_type)s"

#: users/exceptions.py:22
