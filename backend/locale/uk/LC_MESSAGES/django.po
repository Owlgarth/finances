msgstr "Валюта %(code)s використовується: %(summary)s. Видаліть ці посилання, перш ніж вимкнути її."

#: currencies/schemas.py:43
msgid "Value cannot be blank"
msgstr "Значення не може бути порожнім"

#: currencies/schemas.py:49
