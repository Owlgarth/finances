msgid "Name cannot be empty"
msgstr "Назва не може бути порожньою"

#: budgeting/exceptions.py:9
msgid "Budget not found"
msgstr "Бюджет не знайдено"

#: budgeting/exceptions.py:14
msgid "Budget with this name already exists"
msgstr "Бюджет з такою назвою вже існує"

#: budgeting/exceptions.py:19
msgid ""
"Every-N-weeks cadence requires cadence_weeks >= 1 and a cadence_anchor date"
msgstr "Періодичність „кожні N тижнів“ вимагає cadence_weeks >= 1 і дати cadence_anchor"

#: budgeting/exceptions.py:24
msgid "Period not found"
msgstr "Період не знайдено"

#: budgeting/exceptions.py:29
msgid "This budget uses custom periods and no period covers the given date"
msgstr "Цей бюджет використовує власні періоди, і жоден період не охоплює вказану дату"

#: budgeting/exceptions.py:34
msgid "Period overlaps an existing period of this budget"
msgstr "Період перекриває наявний період цього бюджету"

#: budgeting/exceptions.py:39
msgid ""
"Auto-created periods cannot be edited or deleted; only custom periods can"
msgstr "Автоматично створені періоди не можна редагувати чи видаляти; це можливо лише для власних періодів"

#: budgeting/exceptions.py:44
msgid "Category budget not found"
msgstr "Бюджет категорії не знайдено"

#: budgeting/exceptions.py:49
msgid "Category does not belong to this budget"
msgstr "Категорія не належить цьому бюджету"

#: budgeting/schemas.py:39 budgeting/schemas.py:68
msgid "Color must be a valid hex color code (e.g. #FF5733)"
msgstr "Колір має бути допустимим шістнадцятковим кодом кольору (наприклад, #FF5733)"

#: budgeting/schemas.py:116 budgeting/services.py:333
msgid "end_date must be on or after start_date"
msgstr "end_date має бути не раніше за start_date"

#: categories/exceptions.py:9
msgid "Category not found"
msgstr "Категорію не знайдено"

#: categories/exceptions.py:14
msgid "A category with this name already exists in this budget period."
msgstr "Категорія з такою назвою вже існує в цьому періоді бюджету."

#: categories/exceptions.py:19
msgid "A category cannot be merged into itself."
msgstr "Категорію не можна об’єднати з самою собою."

#: common/exceptions.py:19
msgid "An unexpected error occurred"
msgstr "Сталася неочікувана помилка"

#: common/exceptions.py:32
msgid "Not found"
msgstr "Не знайдено"

#: common/exceptions.py:39
msgid "Authentication failed"
msgstr "Помилка автентифікації"

#: common/exceptions.py:46
msgid "Validation error"
msgstr "Помилка валідації"

#: common/exceptions.py:54
#, python-format
