msgid "Account is archived and cannot receive new transactions"
msgstr "Rachunek jest zarchiwizowany i nie może otrzymywać nowych transakcji"

#: transactions/exceptions.py:24
msgid ""
"Amount must be positive (income/expense) or a non-zero delta (adjustment)"
msgstr "Kwota musi być dodatnia (przychód/wydatek) lub niezerową deltą (korekta)"

