msgstr "Wszystkie transakcje i rachunek docelowy muszą należeć do przestrzeni roboczej"

#: transactions/exceptions.py:61
msgid ""
"Target account currency must match the currency of every moved transaction"
msgstr "Waluta rachunku docelowego musi zgadzać się z walutą każdej przenoszonej transakcji"

#: transactions/exceptions.py:71
msgid "Attachment not found"
msgstr "Nie znaleziono załącznika"

