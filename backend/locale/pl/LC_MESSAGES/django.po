msgid "Transactions without an account require an explicit currency_code"
msgstr "Transakcje bez rachunku wymagają jawnego currency_code"

#: transactions/exceptions.py:44
msgid "currency_code does not match the account currency"
msgstr "currency_code nie zgadza się z walutą rachunku"

