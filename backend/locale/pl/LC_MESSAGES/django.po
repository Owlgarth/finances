#: budgeting/exceptions.py:14
msgid "Budget with this name already exists"
msgstr "Budżet o tej nazwie już istnieje"

#: budgeting/exceptions.py:19
msgid ""
"Every-N-weeks cadence requires cadence_weeks >= 1 and a cadence_anchor date"
msgstr "Cykl „co N tygodni” wymaga cadence_weeks >= 1 i daty cadence_anchor"

