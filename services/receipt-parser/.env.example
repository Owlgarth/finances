# Copy to .env — this directory's docker-compose.yml and the app read every
# value from here. Every setting has a default in app/config.py, so only set
# what you change. In the repo's top-level dev stack (`./dev.sh up parser`) the
# parser reads the repo root .env instead — see example.env at the repo root.

# --- Auth ---------------------------------------------------------------------
# Bearer token callers (the Denarly backend) must present. Leave empty ONLY for
# local dev.
PARSER_API_TOKEN=change-me

# --- Deployment (read by docker-compose.yml only, not the app) ----------------
# Interface the published port binds to. On the home server set this to the
# tailnet IP (`tailscale ip -4`) so the port is never exposed to the LAN or the
# internet. The loopback default fails safe if left unset. See docs/deployment.md.
PARSER_BIND_ADDR=127.0.0.1

# --- Model backend ------------------------------------------------------------
# Extraction backend: "openai" (any OpenAI-compatible endpoint, default) or
# "gemini" (Google Gemini API — hosted fallback when the local box is down).
PARSER_MODEL_PROVIDER=openai

# openai provider — OpenAI-compatible chat-completions endpoint. Examples:
#   Ollama:  http://localhost:11434/v1  (model e.g. "qwen2.5-vl", key "not-needed")
#   vLLM:    http://localhost:8000/v1
#   Hosted:  https://api.openai.com/v1  (model "gpt-4o-mini", real key)
PARSER_MODEL_BASE_URL=http://localhost:11434/v1
PARSER_MODEL_NAME=qwen2.5-vl
PARSER_MODEL_API_KEY=not-needed
PARSER_MODEL_TIMEOUT_SECONDS=90
# json_schema = constrained decoding (falls back to json_object on 4xx); or json_object.
PARSER_STRUCTURED_OUTPUT=json_schema

# gemini provider — only read when PARSER_MODEL_PROVIDER=gemini.
PARSER_GEMINI_API_KEY=
PARSER_GEMINI_MODEL=gemini-3.1-flash-lite
# Thinking level low|medium|high; empty = provider default. Low is plenty for receipts.
PARSER_GEMINI_THINKING_LEVEL=low

# --- Upload + rendering limits ------------------------------------------------
PARSER_MAX_FILE_MB=15
PARSER_PDF_RENDER_SCALE=2.0
PARSER_PDF_MAX_PAGES=10

# --- Transcript + OCR ---------------------------------------------------------
# Machine-extracted transcript (PDF text layer / OCR) sent alongside images.
PARSER_TRANSCRIPT_MAX_CHARS=8000
PARSER_OCR_ENABLED=true
