# Production environment for the UNUSED prod/ compose stub.
# Copy to .env and fill in real secrets before any real deployment:
#   cp .env.example .env
# Everything the backend reads at runtime lives here. VITE_* values are NOT
# here: they are baked into the finances-ui image at build time by CI, so
# setting them at runtime would change nothing.

# --- App version -----------------------------------------------------------------
# Must match a published GHCR tag
# (https://github.com/owlgarth/finances/pkgs/container/finances-backend).
# Selects both ghcr.io/owlgarth/finances-backend and -ui.
APP_VERSION=v0.1.0

# --- Published host ports ---------------------------------------------------------
# The only published ports. The ui image has no /api proxy, so the browser
# reaches the api directly on API_PORT until the deferred TLS/routing layer.
API_PORT=8000
UI_PORT=80

# --- Database (host = compose service name) ---------------------------------------
POSTGRES_DB=finances_db
POSTGRES_USER=finances_user
POSTGRES_PASSWORD=change-me-strong-postgres-password
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- Redis / Celery ---------------------------------------------------------------
REDIS_URL=redis://redis:6379
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
CELERY_TASK_ALWAYS_EAGER=false

# --- Django -----------------------------------------------------------------------
SECRET_KEY=change-me-to-a-random-64-char-string
JWT_SECRET_KEY=change-me-to-a-different-random-64-char-string
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
TOKEN_MAX_AGE=604800
DEBUG=false
DEMO_MODE=false
# Future-domain placeholders; the browser origin must match the VITE_API_URL
# the ui image was built with, or CORS will reject it.
ALLOWED_HOSTS=finances.owlgarth.com,localhost,127.0.0.1,api
CORS_ALLOWED_ORIGINS=https://finances.owlgarth.com
FRONTEND_URL=https://finances.owlgarth.com
EXCHANGE_SHORTCUTS_MAX_PER_WORKSPACE=5

# --- Storage ----------------------------------------------------------------------
# S3_ENDPOINT_URL: reached from inside the network. S3_EXTERNAL_URL: from the
# browser - a future placeholder: storage publishes no host port until the
# deferred routing/TLS layer fronts it.
USE_S3_STORAGE=true
S3_ENDPOINT_URL=http://storage:9000
S3_EXTERNAL_URL=https://storage.finances.owlgarth.com
S3_ACCESS_KEY=change-me-rustfs-access-key
S3_SECRET_KEY=change-me-rustfs-secret-key
S3_BUCKET_STATIC=finances-static
S3_BUCKET_MEDIA=finances-media
S3_BUCKET_LOGS=finances-logs

# --- Email (SMTP) - leave EMAIL_HOST empty to print emails to the console ---------
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=noreply@finances.owlgarth.com

# --- Legal documents --------------------------------------------------------------
LEGAL_OPERATOR_NAME="Your Company Name"
LEGAL_OPERATOR_TYPE=company
LEGAL_CONTACT_EMAIL=legal@example.com
LEGAL_CONTACT_ADDRESS=
LEGAL_JURISDICTION="Your Jurisdiction"

# --- Receipt parser (optional) ----------------------------------------------------
# Any service implementing docs/parser-contract.md works. Leave PARSER_URL
# empty to disable extraction entirely - the UI then hides every extraction
# affordance. The remaining client knobs (token, timeouts, retries) default
# sensibly in backend/config/settings.py; see the dev example.env for the
# full list.
PARSER_URL=
